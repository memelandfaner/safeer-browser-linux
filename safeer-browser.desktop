[Desktop Entry]
Version=1.0
Type=Application
Name=Safeer Browser
GenericName=Spletni brskalnik
Comment=Varen in hiter odprtokodni spletni brskalnik za Linux Mint z Messenger, Gmail in YouTube integracijo
Exec=/home/uporabnik/Namizje/linux-mint-safeer-browser/safeer-mint.sh %U
Icon=safeer-browser
Terminal=false
StartupNotify=true
StartupWMClass=safeer-browser
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=NewWindow;PrivateBrowsing;

[Desktop Action NewWindow]
Name=Odpri novo okno
Exec=/home/uporabnik/Namizje/linux-mint-safeer-browser/safeer-mint.sh

[Desktop Action PrivateBrowsing]
Name=Zasebno brskanje
Exec=/home/uporabnik/Namizje/linux-mint-safeer-browser/safeer-mint.sh --private
