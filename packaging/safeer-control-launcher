#!/usr/bin/env bash
# ==============================================================================
# Safeer Control — application launcher (shared by .deb and source checkout).
# Resolves the app payload relative to its own location, like the browser launcher.
# ==============================================================================
PRG="$0"
while [ -h "$PRG" ]; do
    link="$(readlink "$PRG")"
    case "$link" in
        /*) PRG="$link" ;;
        *) PRG="$(dirname "$PRG")/$link" ;;
    esac
done
BIN_DIR="$(cd "$(dirname "$PRG")" && pwd)"
APP_DIR="$(cd "$BIN_DIR/../lib/safeer-control" && pwd)" || {
    echo "Safeer Control: application payload not found next to launcher." >&2
    exit 1
}
exec "${PYTHON:-python3}" "$APP_DIR/safeer_control.py" "$@"
